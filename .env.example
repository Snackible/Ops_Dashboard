# Local dev (plain `npm run dev`) always runs on the localStorage mock —
# there's no serverless function running under it to talk to. Set this to
# "true" only if you're running `vercel dev` instead (which serves the
# Vite app and the /api functions together) and want to test against the
# real Sheets backend locally.
VITE_USE_SHEETS_API=

# The rest of this section is for `vercel dev` / your Vercel project's
# environment variables, NOT this .env.local file — Vite never bundles
# non-VITE_-prefixed vars into the client, and these must never reach the
# browser (they're the credentials that talk to Google on the server side).
# See README's "Real backend (Sheets API via Vercel Functions)" section.
#   GOOGLE_SERVICE_ACCOUNT_EMAIL=
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
#   RATECARD_SPREADSHEET_ID=
#   OPERATIONAL_SPREADSHEET_ID=
#   API_TOKEN=
